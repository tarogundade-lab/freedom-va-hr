PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Used only by seed.js to create the first admin account
ADMIN_EMAIL=admin@freedomva.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# Your deployed frontend URL — used in email links (e.g. "Log in" buttons)
FRONTEND_URL=http://localhost:5173

# Optional: enables email sending via https://resend.com (free tier available).
# Leave blank and the app just skips sending emails — everything else still works.
RESEND_API_KEY=
EMAIL_FROM=Freedom VA <onboarding@yourdomain.com>
ORG_NAME=Freedom VA
